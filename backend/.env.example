# 🌾 krishiCore AI - Backend Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.

APP_NAME=krishicore-ai
ENVIRONMENT=dev
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*

# 🤖 LLM Chat Integration (Groq Cloud API)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 🌦️ Weather Integration (OpenWeatherMap API)
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 📱 SMS Notification Service (Fast2SMS API)
# Get your API key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# 💬 WhatsApp & SMS Backup Notification (Twilio API)
# Get your credentials from: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SMS_FROM=your_twilio_phone_number_here
TWILIO_WHATSAPP_FROM=whatsapp:your_twilio_whatsapp_number_here

# 👨‍🌾 Target Farmer Phone Number for Alerts
FARMER_PHONE=whatsapp:+91XXXXXXXXXX

# 🏛️ Government of India Agricultural Mandi Price API (Open Government Data)
# Get your API key from: https://data.gov.in/
DATA_GOV_API_KEY=your_data_gov_api_key_here
